# .gitignore

# Python #
# Ignore the bytecode cache directory
__pycache__/
*.pyc

# macOS #
# Ignore the file that stores custom folder attributes
.DS_Store

# R #
# Ignore the R command history file
.Rhistory

# Virtual Environments #
# Ignore your local Conda environment folder
.WiGS_Env/

# Ignore SLURM log files
slurm_logs/
*.out
*.err

# Ignore raw simulation results
Results/simulation_results/raw
Results/selection_videos/**/frames_png_for_video/
Results/selection_videos/**/*.png
Results/selection_videos/**/*.svg


# GRFP controls: cluster logs
# Keep the log directories (SLURM resolves --output before the job body runs,
# so they must exist at submit time) but not the logs themselves.
Code/Cluster/RunControls/ClusterMessages/**/*.out
Code/Cluster/RunControls/ClusterMessages/**/*.err
results_grfp_controls/cluster/

# Generated sbatch files: wall times are calibrated by probing the machine that
# generates them, so a committed copy is wrong on any other machine and
# conflicts with the regenerated one on pull. Create them with
# Cluster/1_CreateControlsSbatch.sh.
Code/Cluster/RunControls/controls_*.sbatch
results_grfp_controls/full_suite/*/exp_a_curves.pkl.gz
results_grfp_controls/full_suite/*/exp_a_arms.csv.gz

# The aggregated export is an intermediate the plotting code reads; it is
# roughly the size of the curves again (and twice over, with the truncated
# copy used for the budget-limited AUC). Regenerated by
# Cluster/5_GenerateControlPlots.sh.
results_grfp_controls/manuscript_figures/*/aggregated/
results_grfp_controls/manuscript_figures/*/aggregated_*/

# Controls v2 per-run pickles (curves + selector state); regenerated by
# Cluster/6_RunControlsV2.sbatch or RunControlsV2 --local. SUMMARY_v2.md and
# the area CSVs beside them stay tracked.
Results/controls_v2/raw/
